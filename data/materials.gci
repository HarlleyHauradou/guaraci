composition = { H = 0.023834, O = 0.598898, Al = 0.080446, Si = 0.296821 }
reference = "Also called “soil” or “dirt.” Composition (63.5% SiO2, 15.2% Al2O3, and 21.3% H2O) is from pg 135 of Brewer (2009). Packed earth is 1.52 g/cm3 and excavated earth is 1.25 to 1.60 g/cm3, depending on water content, according to http://www.simetric.co.uk/si_materials.htm (Walker 2009). Many different densities for different types of earth are listed in Table 6.1.5 of Avallone and Baumeister III (1996), and in Table 51.60 of Hungerford (1960)."

