number = 258
density = 1.1 g/cm3
composition = { O = 0.459866, Al = 0.09694, Si = 0.30272, K = 0.140474 }
reference = "Formula from Lide (2008), pgs 4 - 82. This reference lists the density = 2.56 g/cm3. The mineral form of this compound is called microcline. The density for this mineral = 2.56 g/cm3 at http://webmineral.com/data/Microcline.shtml. The density = 1.1 g/cm3 was chosen based on the maximum value for the density for clumping cat litter. See “cat litter (clumping).” This material is sometimes used to bound naturally occurring radioactive material (NORM). It is also called Aluminum Potassium Silicate."

