[material DiatomaceousEarth]
title = "Diatomaceous Earth"
number = 103
density = 0.22 g/cm3
composition = { H = 0.008956, O = 0.546579, Na = 0.009896, Mg = 0.002774, Al = 0.015581, Si = 0.394761, K = 0.011074, Ca = 0.003945, Fe = 0.006434 }
reference = "Also known as DE or diatomite. Diatomaceous earth is a naturally occurring soft sedimentary rock composed of fossilized remains of diatoms, a type of hard-shelled algae. It is usually a major component of cat litter. Density = 0.22 g/cm3 listed for diatomaceous earth product and for diatomite at http://www.powderandbulk.com/resources/bulk_density/material_bulk_density_chart_d.htm (Powder and Bulk Dot Com 2010). Water content is typically 3 to 13 wt% based on http://www.mine- engineer.com/mining/mineral/diatomaceous-earth.htm (Mine-Engineer.Com 2010). Based on this, the water content was assumed to be 8 wt%. The dry weight fractions are based on http://www.matweb.com/search/DataSheet.aspx?MatGUID=3f468dd193804209b8f28e6bdfdbb379&ckck= 1 (Automation Creations 2010)."

[material Earth_TypicalWesternUS]
