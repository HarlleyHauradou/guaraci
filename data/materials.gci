composition = { H = 0.143711, C = 0.856289 }
reference = "Density and weight fractions from http://physics.nist.gov/cgi-bin/Star/compos.pl?matno=225 (NIST 1998). Formula = C3H6 from Brandrup et al. (2005)."

[material Polystyrene]
