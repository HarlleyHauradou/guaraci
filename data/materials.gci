[material Masonite]
title = "Masonite"
number = 190
density = 1.3 g/cm3
composition = { H = 0.062165, C = 0.444455, O = 0.49338 }
reference = "Masonite is a type of hardboard (http://en.wikipedia.org/wiki/Masonite) produced from by-product wood chips reduced to cellulose fibers by high-pressure steam (Table 51.114 of Hungerford 1960) so cellulose (C6H10O5) is used for the formula. Density = 1.3 g/cm3 from this ref., and from pg II.F.1-5 of Carter et al. (1968). Average density of Masonite is listed at http://www.hudsonhighland.com/fiberboardchart.htm as about 79 to 80 lb/ft3, which averages to 1.27 g/cm3."

