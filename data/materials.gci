# Guaraci material database
#
# Source: R.J. McConn Jr, C.J. Gesh, R.T. Pagh, R.A. Rucker, R.G. Williams III,
# "Compendium of Material Composition Data for Radiation Transport Modeling",
# PNNL-15870 Rev. 1 (PIET-43741-TM-963), Pacific Northwest National Laboratory, March 2011.
#
# Compositions are mass fractions (Guaraci normalises them to sum to one).
# `number` is the material number in the compendium.
# Densities are typical values; when you know the real density, copy the material:
#   [material MyFoam]
#   same_as = Polystyrene
#   density = 0.05 g/cm3

[material A150TissueEquivalentPlastic]
title = "A-150 Tissue-Equivalent Plastic (A150TEP)"
number = 1
density = 1.127 g/cm3
composition = { H = 0.101327, C = 0.775501, N = 0.035057, O = 0.052316, F = 0.017422, Ca = 0.018378 }
reference = "Density and weight fractions from http://physics.nist.gov/cgi-bin/Star/compos.pl?matno=099 (NIST 1998)."

[material Acetone]
title = "Acetone"
number = 2
density = 0.7899 g/cm3
composition = { H = 0.104122, C = 0.620405, O = 0.275473 }
reference = "Density and weight fractions from http://physics.nist.gov/cgi-bin/Star/compos.pl?matno=100 (NIST 1998). Formula from http://www.matweb.com/search/DataSheet.aspx?MatGUID=1f9fd4a5357e428f9a82e750f4fbbf0e (Automation Creations 2010). Formula and density = 0.7845 in Lide (2008), pgs 3 - 4."

[material Acetylene]
title = "Acetylene"
number = 3
density = 0.001097 g/cm3
composition = { H = 0.077418, C = 0.922582 }
reference = "Density and weight fractions from http://physics.nist.gov/cgi-bin/Star/compos.pl?matno=101 (NIST 1998). Formula from Lide (2008), pgs 3 - 6."

[material Air]
title = "Air (Dry, Near Sea Level)"
number = 4
density = 0.001205 g/cm3
composition = { C = 0.000124, N = 0.755268, O = 0.231781, Ar = 0.012827 }
reference = "Density and weight fractions from http://physics.nist.gov/PhysRefData/XrayMassCoef/tab2.html (NIST 1996). Note: This NIST data yields a CO2 content in air of about 299 ppm by volume, whereas measurements at the Mauna Loa Observatory in 2004 indicate an average CO2 content of 377.38 ppm (Lide 2009, pgs 14 - 28)."

