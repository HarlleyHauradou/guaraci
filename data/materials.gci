reference = "Density and weight fractions from http://physics.nist.gov/PhysRefData/XrayMassCoef/tab2.html (NIST 1996). Abbreviated PS (http://en.wikipedia.org/wiki/Polystyrene) and called Styrofoam (http://en.wikipedia.org/wiki/Styrofoam). Formula = C8H8 from Brandrup et al. (2005)."

[material Polytetrafluoroethylene]
title = "Polytetrafluoroethylene (PTFE)"
number = 252
