msgid "`endf.rs` implements the CONT/HEAD, LIST and TAB1 records of the 80-column format:"
msgstr "`endf.rs` implementa los registros CONT/HEAD, LIST y TAB1 del formato de 80 columnas:"

msgid "Real numbers accept the compact form without `E` (`1.234567+5`) and blank fields (= 0)."
msgstr "Los números reales aceptan la forma compacta sin `E` (`1.234567+5`) y los campos en blanco (= 0)."

msgid "The file is split into `(MF, MT)` sections by columns 71–75."
msgstr "El archivo se divide en secciones `(MF, MT)` según las columnas 71–75."

msgid "Photo-atomic data (MF23, MF27)"
msgstr "Datos fotoatómicos (MF23, MF27)"

msgid "Section"
msgstr "Sección"

msgid "Quantity"
msgstr "Magnitud"

msgid "Unit in Guaraci"
msgstr "Unidad en Guaraci"

